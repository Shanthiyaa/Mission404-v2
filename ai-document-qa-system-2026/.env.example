# ── PostgreSQL connection string ──────────────────────────────────────────────
# Sign up at https://neon.tech (free tier) or Supabase and paste your connection string.
# Format: postgresql+psycopg://user:password@host:5432/dbname?sslmode=require
# (The application also auto-rewrites postgresql:// or postgres:// to use psycopg)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require

# ── JWT secret (change in production!) ────────────────────────────────────────
JWT_SECRET=SUPER_SECRET_SECURITY_KEY_ALE_ASSISTANT_2026
